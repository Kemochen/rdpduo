@@ -961,6 +969,56 @@
 #pragma mark -
 #pragma mark Helper functions
 
+- (CGRect)duoViewportFrame
+{
+	UIView *rootView = [self view];
+	CGRect viewport = [[rootView safeAreaLayoutGuide] layoutFrame];
+	if (CGRectIsEmpty(viewport))
+		viewport = [rootView bounds];
+
+#if __IPHONE_OS_VERSION_MAX_ALLOWED >= 270100
+	if (@available(iOS 27.1, *))
+	{
+		NSArray<UIViewReservedRegion *> *regions =
+		    [rootView reservedRegionsOfKind:[UIViewReservedRegionKind divisionRegionKind]];
+		for (UIViewReservedRegion *region in regions)
+		{
+			if (![region isActive])
+				continue;
+
+			CGRect fold = CGRectIntersection([region frame], viewport);
+			if (CGRectIsNull(fold) || CGRectIsEmpty(fold))
+				continue;
+
+			if (CGRectGetHeight(fold) >= CGRectGetWidth(fold))
+			{
+				CGRect leading = CGRectMake(CGRectGetMinX(viewport), CGRectGetMinY(viewport),
+				                            MAX(0.0, CGRectGetMinX(fold) - CGRectGetMinX(viewport)),
+				                            CGRectGetHeight(viewport));
+				CGRect trailing = CGRectMake(CGRectGetMaxX(fold), CGRectGetMinY(viewport),
+				                             MAX(0.0, CGRectGetMaxX(viewport) - CGRectGetMaxX(fold)),
+				                             CGRectGetHeight(viewport));
+				viewport = CGRectGetWidth(trailing) >= CGRectGetWidth(leading) ? trailing : leading;
+			}
+			else
+			{
+				CGRect upper = CGRectMake(CGRectGetMinX(viewport), CGRectGetMinY(viewport),
+				                          CGRectGetWidth(viewport),
+				                          MAX(0.0, CGRectGetMinY(fold) - CGRectGetMinY(viewport)));
+				CGRect lower = CGRectMake(CGRectGetMinX(viewport), CGRectGetMaxY(fold),
+				                          CGRectGetWidth(viewport),
+				                          MAX(0.0, CGRectGetMaxY(viewport) - CGRectGetMaxY(fold)));
+				// In laptop posture the remote desktop belongs above the fold. Fall back to
+				// the lower region only if the upper region is not usable.
+				viewport = CGRectGetHeight(upper) > TOOLBAR_HEIGHT ? upper : lower;
+			}
+		}
+	}
+#endif
+
+	return viewport;
+}
