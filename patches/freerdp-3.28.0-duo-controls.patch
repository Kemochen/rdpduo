+	[button addTarget:self action:action forControlEvents:UIControlEventTouchUpInside];
+	return button;
+}
+
+- (void)requestDuoDynamicResolution
+{
+	if ([[_session params] intForKey:@"screen_resolution_type"] != TSXScreenOptionFitScreen)
+		return;
+
+	CGSize size = [self sizeForFitScreenForSession:_session];
+	rdpSettings *settings = [_session getSessionParams];
+	CGSize current = CGSizeMake(freerdp_settings_get_uint32(settings, FreeRDP_DesktopWidth),
+	                            freerdp_settings_get_uint32(settings, FreeRDP_DesktopHeight));
+	if (CGSizeEqualToSize(size, current) || CGSizeEqualToSize(size, _last_dynamic_resolution_size))
+		return;
+
+	if ([_session requestDesktopSize:size])
+		_last_dynamic_resolution_size = size;
+}
