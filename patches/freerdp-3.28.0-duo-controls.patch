+	    [self mfi]->connection_state != TSXConnectionConnected)
+		return NO;
+
+	return ios_events_send(
+	    [self mfi], [NSDictionary dictionaryWithObjectsAndKeys:@"resize", @"type",
+	                                                           [NSNumber numberWithUnsignedInt:width],
+	                                                           @"width",
+	                                                           [NSNumber numberWithUnsignedInt:height],
+	                                                           @"height", nil]);
+}
