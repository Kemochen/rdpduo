+- (void)configureDuoTrackpad
+{
+	_duo_trackpad_view = [[UIView alloc] initWithFrame:CGRectZero];
+	[_duo_trackpad_view setBackgroundColor:[UIColor colorWithWhite:0.08 alpha:1.0]];
+	[[_duo_trackpad_view layer] setBorderColor:[[UIColor colorWithWhite:0.28 alpha:1.0] CGColor]];
+	[[_duo_trackpad_view layer] setBorderWidth:1.0];
+	[_duo_trackpad_view setHidden:YES];
+
+	UILabel *label = [[[UILabel alloc] initWithFrame:CGRectZero] autorelease];
+	[label setAutoresizingMask:UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight];
+	[label setFrame:[_duo_trackpad_view bounds]];
+	[label setText:NSLocalizedString(@"Touchpad\nTap: click  •  Two-finger tap: right click\nTwo-finger swipe: scroll  •  Hold and move: drag",
+	                               @"iPhone Duo touchpad instructions")];
+	[label setNumberOfLines:3];
+	[label setTextAlignment:NSTextAlignmentCenter];
+	[label setTextColor:[UIColor colorWithWhite:0.72 alpha:1.0]];
+	[label setFont:[UIFont systemFontOfSize:13.0 weight:UIFontWeightMedium]];
+	[_duo_trackpad_view addSubview:label];
+
+	UITapGestureRecognizer *tap = [[[UITapGestureRecognizer alloc]
+	    initWithTarget:self
+	            action:@selector(handleDuoTrackpadTap:)] autorelease];
+	UITapGestureRecognizer *secondaryTap = [[[UITapGestureRecognizer alloc]
+	    initWithTarget:self
+	            action:@selector(handleDuoTrackpadSecondaryTap:)] autorelease];
+	[secondaryTap setNumberOfTouchesRequired:2];
+	UIPanGestureRecognizer *pan = [[[UIPanGestureRecognizer alloc]
+	    initWithTarget:self
+	            action:@selector(handleDuoTrackpadPan:)] autorelease];
+	[pan setMaximumNumberOfTouches:1];
+	UIPanGestureRecognizer *scroll = [[[UIPanGestureRecognizer alloc]
+	    initWithTarget:self
+	            action:@selector(handleDuoTrackpadScroll:)] autorelease];
+	[scroll setMinimumNumberOfTouches:2];
+	[scroll setMaximumNumberOfTouches:2];
+	UILongPressGestureRecognizer *hold = [[[UILongPressGestureRecognizer alloc]
+	    initWithTarget:self
+	            action:@selector(handleDuoTrackpadLongPress:)] autorelease];
+	[hold setMinimumPressDuration:0.45];
+	[tap requireGestureRecognizerToFail:hold];
+	[pan setDelegate:self];
+	[hold setDelegate:self];
+
+	[_duo_trackpad_view addGestureRecognizer:tap];
+	[_duo_trackpad_view addGestureRecognizer:secondaryTap];
+	[_duo_trackpad_view addGestureRecognizer:pan];
+	[_duo_trackpad_view addGestureRecognizer:scroll];
+	[_duo_trackpad_view addGestureRecognizer:hold];
+	[[self view] addSubview:_duo_trackpad_view];
+	[label setFrame:[_duo_trackpad_view bounds]];
+}
+
+- (void)handleDuoTrackpadPan:(UIPanGestureRecognizer *)gesture
+{
+	CGPoint location = [gesture locationInView:_duo_trackpad_view];
+	if ([gesture state] == UIGestureRecognizerStateBegan)
+		_duo_trackpad_last_location = location;
+	else if ([gesture state] == UIGestureRecognizerStateChanged)
+	{
+		CGPoint delta = CGPointMake((location.x - _duo_trackpad_last_location.x) * 1.5,
+		                            (location.y - _duo_trackpad_last_location.y) * 1.5);
+		[self moveCursorByViewportDelta:delta];
+		_duo_trackpad_last_location = location;
+	}
+}
+
+- (void)handleDuoTrackpadTap:(UITapGestureRecognizer *)gesture
+{
+	(void)gesture;
+	[self sendMouseButtonEvent:GetLeftMouseButtonClickEvent(YES)];
+	[self sendMouseButtonEvent:GetLeftMouseButtonClickEvent(NO)];
+}
+
+- (void)handleDuoTrackpadSecondaryTap:(UITapGestureRecognizer *)gesture
+{
+	(void)gesture;
+	[self sendMouseButtonEvent:GetRightMouseButtonClickEvent(YES)];
+	[self sendMouseButtonEvent:GetRightMouseButtonClickEvent(NO)];
+}
+
+- (void)handleDuoTrackpadScroll:(UIPanGestureRecognizer *)gesture
+{
+	CGFloat delta = [gesture translationInView:_duo_trackpad_view].y;
+	if (fabs(delta) < GetScrollGestureDelta())
+		return;
+	CGPoint position = [self currentCursorViewPosition];
+	[_session sendInputEvent:[self eventDescriptorForMouseEvent:GetMouseWheelEvent(delta > 0)
+	                                                   position:position]];
+	[gesture setTranslation:CGPointZero inView:_duo_trackpad_view];
+}
+
+- (void)handleDuoTrackpadLongPress:(UILongPressGestureRecognizer *)gesture
+{
+	if ([gesture state] == UIGestureRecognizerStateBegan)
+	{
+		[self sendMouseButtonEvent:GetLeftMouseButtonClickEvent(YES)];
+		_duo_trackpad_drag_active = YES;
+	}
+	else if ([gesture state] == UIGestureRecognizerStateEnded ||
+	         [gesture state] == UIGestureRecognizerStateCancelled ||
+	         [gesture state] == UIGestureRecognizerStateFailed)
+	{
+		if (_duo_trackpad_drag_active)
+			[self sendMouseButtonEvent:GetLeftMouseButtonClickEvent(NO)];
+		_duo_trackpad_drag_active = NO;
+	}
 }
 
